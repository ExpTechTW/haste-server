# === zh-Hant ===
# 複製為 .env 後再編輯。實際的環境變數永遠優先於此檔，
# 所以容器部署可以直接用環境變數設定，不需要重建映像。
# === en-US ===
# Copy to .env and edit. Real environment variables always override this file,
# so a container deployment can set anything here without rebuilding.

# ---------------------------------------------------------------- networking

# === zh-Hant ===
# 伺服器監聽位址（addr:port）。
# === en-US ===
# Address to listen on.
HASTE_ADDR=:8080

# === zh-Hant ===
# 產生分享連結用的絕對 origin（http(s)://host）。留空則依每個請求自動推導，
# 多數單機部署用預設即可。
# /docs 的 API 文件頁也用它當 Base URL —— 那正是別人要呼叫的位址，
# 在反向代理後面時不會等於瀏覽器當下所在的主機。留空時文件頁才退回後者。
# === en-US ===
# Absolute origin used to build share links. Leave empty to derive it from each
# request, which is correct for most single-host deployments.
# The API reference at /docs shows this as its base URL — the address people
# should actually call, which behind a proxy is not the host the browser is on.
# Only when this is empty does that page fall back to the latter.
HASTE_BASE_URL=

# === zh-Hant ===
# 是否信任 X-Forwarded-For / X-Forwarded-Proto。只有在你自己控制的 Proxy 之後才開啟：
# 這兩個 header 極易偽造，且會影響限流判斷（依 client IP）。
# === en-US ===
# Honour X-Forwarded-For / X-Forwarded-Proto. Only enable behind a proxy you
# control: these headers are trivially spoofed and drive the rate limiter.
HASTE_TRUST_PROXY=false

# === zh-Hant ===
# JSON API 允許的 origin（逗號分隔），* 表示全部放行。
# === en-US ===
# Comma-separated allowed origins for the JSON API, or * for any.
HASTE_CORS_ORIGINS=*

# ------------------------------------------------------------------- limits

# === zh-Hant ===
# 單筆 paste 的字元上限（Unicode 碼點數，非位元組數）。
# 預設 40000，是經典 haste-server（400000）的十分之一，這是刻意的：
# 40000 字元約等於 300 行結構化 log、1500 行原始碼，或 40000 個中文字（約 30 頁 A4）；
# 同時這也是編輯器還能在 16ms 一幀內完成即時上色的最後尺寸
# （40k 約 14ms、60k 約 21ms）。再大就得關掉上色才能維持流暢。
# 另外請求 body 上限為此值 ×12 bytes（JSON 允許 \uXXXX 轉義，代理對一個 code point 要 12 bytes），
# 反向代理的 client_max_body_size 要放行。
# === en-US ===
# Maximum characters (Unicode code points, not bytes) per paste. The default is
# a tenth of the classic haste-server's 400000, deliberately: 40000 characters
# is roughly 300 lines of structured log, 1500 lines of source, or 40000 Chinese
# characters — about thirty A4 pages — and it is the last size at which the
# editor can still colour the text on every keystroke inside a 16ms frame (40k
# costs ~14ms, 60k ~21ms). The request body limit is this times twelve bytes —
# JSON may escape each character, and a surrogate pair costs 12 — so a reverse
# proxy's client_max_body_size has to allow for that.
HASTE_MAX_CHARS=40000

# === zh-Hant ===
# 每個 client IP 每秒允許建立的 paste 數（持續速率）與突發額度。
# 設 HASTE_RATE_RPS=0 可關閉限流。讀取永遠不限流。
# === en-US ===
# Sustained paste creations per client IP per second, and the burst allowance.
# Set HASTE_RATE_RPS=0 to disable rate limiting. Reads are never limited.
HASTE_RATE_RPS=1
HASTE_RATE_BURST=20

# --------------------------------------------------------------- retention

# === zh-Hant ===
# 保留是一筆「預算」而非「保證」，伺服器不會向客戶端承諾做不到的存活時間。
# === en-US ===
# Retention is a budget, not a promise, and the client is never told a lifetime
# the server cannot honour.

# === zh-Hant ===
# HASTE_MAX_BYTES 是硬性保證：每次寫入都會檢查，容量不足時會逐出
# 「最久未被讀取」的 paste 來騰出空間。
# 每筆佔用的空間差距極大，取決於內容與長度：4000 字元的 log 約 500 bytes，
# 滿版 40000 字元的 log 約 1 KB，而同樣滿版但不可壓縮的中文約 85 KB。
# 所以 1 GiB 可能存下數百萬筆小 paste，也可能只存下約一萬筆滿版的。
# 上限一定要大於「單筆最大 paste」，否則每次寫入都會立刻被逐出（啟動時會擋下）。
# 設 0 表示不設上限——只有當磁碟由其他機制控管時才這樣做。
# === en-US ===
# HASTE_MAX_BYTES is the hard guarantee: it is checked on every write, and a
# paste that does not fit evicts the least recently *read* pastes to make room.
# What a paste costs varies enormously with its content and length: a 4000
# character log takes about 500 bytes, a full 40000 character log about 1 KB,
# and the same length of incompressible CJK about 85 KB. So a 1 GiB cap holds
# millions of small pastes or roughly ten thousand maximal ones. The cap must exceed a single largest paste or every write would be
# evicted immediately, which startup refuses.
# Set to 0 for no cap — only do that if something else bounds the disk.
HASTE_MAX_BYTES=1GiB

# === zh-Hant ===
# 可選的「存活時間」策略，在容量上限之後套用。兩者預設都是關閉：
# 若都不設，就只由容量上限決定刪除什麼。
#
#   HASTE_TTL_ACCESS  丟棄超過這段時間沒人讀過的 paste（LRU）
#   HASTE_TTL_CREATE  丟棄「建立時間」超過此期限的 paste，不管多常被讀
#
# 留空或 0 表示完全停用。支援 h/m/s 以及 d(天)、w(週)：如 30d、12h、2w。
# === en-US ===
# Optional age policies, applied after the byte cap. Both are OFF by default:
# with neither set, the byte cap alone decides what gets removed.
#
#   HASTE_TTL_ACCESS  drop pastes nobody has read for this long (LRU)
#   HASTE_TTL_CREATE  drop pastes older than this, however often they are read
#
# Empty or 0 disables a rule entirely. Accepts h/m/s plus d and w: 30d, 12h, 2w.
HASTE_TTL_ACCESS=
HASTE_TTL_CREATE=

# === zh-Hant ===
# 保留規則的執行間隔。容量上限是每次寫入都強制檢查的；
# 這個週期性的清理動作負責套用 TTL、刪除到期的臨時貼文並回收磁碟空間。
# 貼文自己設定的期限一到就會立刻停止提供（讀取時就過濾掉），
# 所以連結是準時失效的；這個值決定的是資料實際被抹掉最多會晚多久。
# 它會透過 /api/config 發布出去，期限選單直接照著它寫給使用者看。
# === en-US ===
# How often the retention rules are applied. The byte cap is enforced on every
# write regardless; this sweep is what applies the TTLs, deletes expired
# temporary pastes, and reclaims disk.
# A paste's own lifetime takes effect the instant it runs out — reads filter
# expired rows — so links die on time; this value is only how long the data can
# outlive them. It is published through /api/config, and the expiry picker
# quotes it back to the user rather than assuming an hour.
HASTE_CLEANUP_INTERVAL=1h

# === zh-Hant ===
# 誰可以讀 /api/stats：off（預設）、token、public。
# 預設關閉，因為那些數字對攻擊者的價值遠高於對使用者的價值：
# 總量每次只跳動一則貼文，輪詢就能推出每一則新貼文的原始與壓縮大小；
# usedFraction 讓「灌爆空間上限」變成一件有進度條的事；
# 而 count 下降就是別人的貼文正在被擠掉的收據。
# off    回 404，跟這個路由不存在一樣。
# token  需要 Authorization: Bearer <HASTE_STATS_TOKEN>，給監控系統用。
# public 對所有人開放，這是一個明確的選擇。
# === en-US ===
# Who may read /api/stats: off (default), token, or public.
# Off by default because the numbers are worth far more to someone attacking the
# instance than to anyone using it: the totals move one paste at a time, so
# polling them reveals the size of every paste as it arrives; usedFraction turns
# filling the storage cap into a task with a progress bar; and a falling count
# is a receipt confirming other people's pastes have been evicted.
# off    answers 404, as if the route did not exist.
# token  requires Authorization: Bearer <HASTE_STATS_TOKEN>, for monitoring.
# public serves it to anyone, which is a deliberate choice.
HASTE_STATS=off

# === zh-Hant ===
# HASTE_STATS=token 時必填，至少 16 個字元。
# === en-US ===
# Required when HASTE_STATS=token. At least 16 characters.
HASTE_STATS_TOKEN=

# ----------------------------------------------------------------- storage

# === zh-Hant ===
# SQLite 資料庫檔路徑。
# === en-US ===
# Path to the SQLite database file.
HASTE_DB_PATH=data/haste.db

# === zh-Hant ===
# 每個連線的 SQLite page cache 大小（MiB）。總記憶體用量約為
# 此值 ×（1 個寫入連線 + HASTE_READ_POOL 個讀取連線）。
# === en-US ===
# SQLite page cache per connection, in MiB. Total footprint is roughly
# this value x (1 writer + HASTE_READ_POOL readers).
HASTE_SQLITE_CACHE_MB=48

# === zh-Hant ===
# 並行唯讀連線數。寫入連線永遠只有一個，因為 SQLite 只允許這樣。
# === en-US ===
# Concurrent read-only connections. The writer is always exactly one, because
# that is all SQLite allows.
HASTE_READ_POOL=8

# === zh-Hant ===
# 寫入的進入管制。超過 HASTE_WRITE_CONCURRENCY 個同時寫入時，請求進入佇列；
# 等待數超過 HASTE_WRITE_QUEUE 就直接回 503，避免請求卡在一條不值得等的隊列裡。
# 預設為每個 CPU 核心一個寫入。
# === en-US ===
# Admission control for writes. Beyond HASTE_WRITE_CONCURRENCY simultaneous
# writes, callers queue; beyond HASTE_WRITE_QUEUE waiting, they are refused with
# 503 rather than left holding a request buffer in a line that is not worth
# joining. Defaults to one write per core.
# HASTE_WRITE_CONCURRENCY=
HASTE_WRITE_QUEUE=512

# --------------------------------------------------------------- compression

# === zh-Hant ===
# zstd 壓縮等級，1-22。預設 19，是根據此伺服器自己的語料庫實測得出：
# 對這種尺寸的輸入，比 gzip、bzip2、xz、brotli 都存得更小，且 20-22 產生相同結果。
# 壓縮是寫入路徑的最大成本，調低可犧牲大小換取吞吐量——level 4 每筆約大 6%，
# 但 CPU 只花約 1/20。
# === en-US ===
# zstd level, 1-22. The default is 19, chosen from measurements on this server's
# own corpus: it stores less than gzip, bzip2, xz or brotli do on inputs this
# size, and levels 20-22 produce identical output. Compression is the write
# path's dominant cost, so lowering it trades bytes for throughput — level 4 is
# roughly 6% larger per paste for about a twentieth of the CPU.
# HASTE_ZSTD_LEVEL=19

# ------------------------------------------------------------------- codes

# === zh-Hant ===
# 最短分享碼長度，base62 的 1-10 字元。分享碼本身永遠不可猜測，
# 但長度決定攻擊者需要掃描多大的空間：8 字元有 2.2×10^14 種組合，
# 窮舉網址空間毫無意義。只有當你刻意想要很短的連結時才調低。
# === en-US ===
# Shortest share code to issue, 1-10 characters of base62. Codes are always
# unguessable, but length is what decides how much of the space an attacker
# would have to sweep: 8 characters is 2.2e14 codes, so walking the URL space
# is pointless. Lower it only if you want deliberately tiny links.
HASTE_CODE_MIN_LEN=8

# ------------------------------------------------------------------ secrets

# === zh-Hant ===
# 用來把序號置換成分享碼的密鑰。留空則首次啟動時自動產生並儲存在資料庫旁。
# 更換它不會弄壞既有 paste：分享碼是「儲存」的，不是「反推」出來的。
# === en-US ===
# Keys the permutation that turns sequence numbers into share codes. Leave
# empty and one is generated and persisted next to the database on first run.
# Changing it cannot break existing pastes; codes are stored, not derived.
HASTE_ID_SECRET=